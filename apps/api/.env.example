# --- App ---
PHOTOGRID_ENV=development
PHOTOGRID_LOG_LEVEL=INFO
PHOTOGRID_CORS_ORIGINS=http://localhost:3000,https://photogrid.store

# --- Firebase ---
# Either point to a service-account JSON file...
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json
# ...or paste its contents inline (single line, escaped JSON):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FIREBASE_PROJECT_ID=photogrid-1822d
FIREBASE_STORAGE_BUCKET=photogrid-1822d.firebasestorage.app
